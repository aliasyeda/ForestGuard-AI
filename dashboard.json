{
  "dashboard": {
    "title": "ForestGuard AI Monitoring",
    "description": "Model Performance and Prediction Metrics",
    "panels": [
      {
        "title": "Total Predictions",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(forestguard_predictions_total)"
          }
        ]
      },
      {
        "title": "Average Churn Probability",
        "type": "gauge",
        "targets": [
          {
            "expr": "avg(forestguard_churn_probability)"
          }
        ],
        "options": {
          "max": 1,
          "min": 0,
          "thresholds": [
            {"color": "green", "value": 0},
            {"color": "yellow", "value": 0.3},
            {"color": "red", "value": 0.7}
          ]
        }
      },
      {
        "title": "Predictions Over Time",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(forestguard_predictions_total[1h])"
          }
        ]
      },
      {
        "title": "Risk Distribution",
        "type": "piechart",
        "targets": [
          {
            "expr": "forestguard_risk_level"
          }
        ]
      }
    ]
  }
}